# Copy this file to .env and fill it in:   cp .env.example .env
# Never commit .env — it holds your API key.

# ---- The brain ----
# mock   = no key needed, rule-based stand-in (use for rehearsals)
# gemini = Google Gemini (needs GEMINI_API_KEY)
LLM_PROVIDER=mock
GEMINI_API_KEY=
LLM_MODEL=gemini-flash-latest

# ---- The database ----
# Empty = in-memory (nothing to install, data resets on restart)
# Local MongoDB:   mongodb://localhost:27017
# MongoDB Atlas:   mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net
# (docker compose sets this for you automatically)
MONGO_URI=
MONGO_DB=parcelpe

# ---- Rollout ----
# shadow = AI decides and drafts, nothing is sent | live = safe replies are sent
MODE=shadow

# ---- Guardrails ----
ENABLE_ACTION_LIMITS=true
REFUND_AUTO_LIMIT_INR=2000
MIN_CONFIDENCE=0.7
